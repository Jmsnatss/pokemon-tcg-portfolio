# ============================================================
# PokéVault — Environment Variables Reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real credentials.
# ============================================================

# --- Supabase ---
# Found at: https://supabase.com/dashboard/project/<project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # server-side only

# --- TCGdex (card catalog, free & open) ---
# No API key required. Optionally set a custom base URL.
NEXT_PUBLIC_TCGDEX_BASE_URL=https://api.tcgdex.net/v2

# --- JustTCG (pricing) ---
# Register at https://justtcg.com to obtain your key.
# Free key (no card): https://justtcg.com . Free tier = 100 requests/day. Used for graded (PSA/BGS/CGC) prices.
JUSTTCG_API_KEY=your-justtcg-api-key

# --- PriceCharting (optional secondary pricing) ---
PRICECHARTING_API_KEY=your-pricecharting-api-key

# --- Frankfurter (currency conversion, free, no key needed) ---
FRANKFURTER_BASE_URL=https://api.frankfurter.dev

# --- Python scanner service (OPTIONAL, currently unused by the web app) ---
# The web app scans on-device with Tesseract.js. These are only for the optional services/scanner backend.
SCANNER_SERVICE_URL=http://localhost:8000
# Optional shared secret for authenticating scanner requests.
SCANNER_API_SECRET=your-scanner-secret

# --- Scheduled price sync ---
# Long random string. Set the same value as a Vercel env var and as the CRON_SECRET GitHub secret
# (plus an APP_URL GitHub secret with your deployed URL).
CRON_SECRET=generate-a-long-random-string

# --- Application ---
# Used by Next.js to build absolute URLs in server components.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Single-user mode ---
# Signups are controlled in Supabase, not by an env var: turn off
# "Allow new users to sign up" under Authentication > Sign In / Providers.

