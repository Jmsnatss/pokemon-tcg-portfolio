# ============================================================
# PokéVault — Root .gitignore
# ============================================================

# --- Node / Next.js ---
node_modules/
.pnpm-store/
.next/
.turbo/
out/
dist/
build/
*.tsbuildinfo
.npm
.yarn/cache
.yarn/unplugged

# --- Python / Scanner service ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
env/
.env_python/
*.egg-info/
dist/
build/
*.so
*.dylib
.pytest_cache/
htmlcov/
.coverage
.coverage.*
*.log

# --- Model caches and weights ---
models/
*.onnx
*.pt
*.pth
*.bin
*.safetensors
model_cache/
huggingface_cache/
.cache/

# --- Temporary uploads ---
uploads/
tmp/
temp/
.tmp/

# --- Secrets and credentials ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
secrets/
*.pem
*.key
*.crt
*.p12

# --- Supabase ---
supabase/.temp/
supabase/functions/.cache/

# --- OS artefacts ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# --- IDE ---
.vscode/settings.json
.idea/
*.iml

# --- Testing ---
coverage/
playwright-report/
test-results/

# --- Vercel ---
.vercel/

# --- pnpm workspace lock files in sub-packages (keep root only) ---
apps/web/pnpm-lock.yaml
